# ============================================
# AFFILIATE COURSE PLATFORM - SECURE ENVIRONMENT CONFIG
# ============================================

# Application Configuration
APP_NAME="Affiliate Course Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Logging Configuration
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============================================
# DATABASE CONFIGURATION (PDO)
# ============================================
# Primary Database Connection
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=affiliate_platform
DB_USERNAME=affiliate_user
DB_PASSWORD=SecurePassword123!

# Database Security Options
DB_STRICT_MODE=true
DB_ENGINE=InnoDB
DB_TIMEZONE=+00:00
DB_PREFIX=
DB_PERSISTENT=false

# Database SSL Configuration (for production)
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
DB_SSL_CIPHER=
DB_SSL_VERIFY=false

# Connection Pool Settings
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=10
DB_WAIT_TIMEOUT=60
DB_HEARTBEAT=-1
DB_MAX_IDLE_TIME=3600

# ============================================
# CACHE & SESSION CONFIGURATION
# ============================================
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_PREFIX=affiliate:

# ============================================
# EMAIL CONFIGURATION
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# SECURITY CONFIGURATION
# ============================================

# Google reCAPTCHA
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_ENABLED=true

# Google 2FA
GOOGLE2FA_ENABLED=true
GOOGLE2FA_ISSUER="${APP_NAME}"

# JWT Configuration (for API)
JWT_SECRET=your-jwt-secret-key-here
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Encryption Keys
ENCRYPTION_KEY=your-encryption-key-here
API_KEY=your-api-key-here

# ============================================
# TRACKING & ANALYTICS
# ============================================

# Google Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX
GOOGLE_ANALYTICS_ENABLED=true

# Meta Pixel
META_PIXEL_ID=your-meta-pixel-id
META_PIXEL_ENABLED=true

# ============================================
# FINANCIAL SETTINGS
# ============================================

# Withdrawal Configuration
WITHDRAWAL_DAYS="1,2,3,4,5"
WITHDRAWAL_START_TIME="09:00"
WITHDRAWAL_END_TIME="18:00"
WITHDRAWAL_FEE_TYPE=percentage
WITHDRAWAL_FEE_VALUE=5.00
WITHDRAWAL_MIN_AMOUNT=50.00
WITHDRAWAL_MAX_AMOUNT=10000.00

# Commission Settings
COMMISSION_AUTO_CALCULATE=true
COMMISSION_PAYOUT_DAYS=30
COMMISSION_MIN_PAYOUT=100.00

# ============================================
# FILE STORAGE CONFIGURATION
# ============================================

# File Upload Limits
MAX_UPLOAD_SIZE=2048
ALLOWED_FILE_TYPES="jpg,jpeg,png,gif,pdf,doc,docx"

# Storage Paths
STORAGE_PATH=storage/app/public
PUBLIC_STORAGE_PATH=storage

# ============================================
# CACHE CONFIGURATION
# ============================================

# Cache TTL (Time To Live) in minutes
CACHE_TTL_DEFAULT=60
CACHE_TTL_STATS=15
CACHE_TTL_REPORTS=30
CACHE_TTL_USERS=120

# ============================================
# SECURITY HEADERS
# ============================================

SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
CONTENT_SECURITY_POLICY_ENABLED=true
X_FRAME_OPTIONS=SAMEORIGIN
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION="1; mode=block"

# ============================================
# FEATURE FLAGS
# ============================================

FEATURE_2FA_ENABLED=true
FEATURE_AFFILIATE_TRACKING=true
FEATURE_COMMISSION_AUTO_PAYOUT=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_ANALYTICS_DASHBOARD=true
FEATURE_ADVANCED_REPORTS=true

# ============================================
# CUSTOM CONFIGURATION
# ============================================

# Platform Specific Settings
PLATFORM_VERSION=1.0.0
PLATFORM_SUPPORT_EMAIL=support@yourdomain.com

# Timezone
APP_TIMEZONE=UTC
DEFAULT_LOCALE=en
FALLBACK_LOCALE=en

# Currency Settings
DEFAULT_CURRENCY=USD
CURRENCY_SYMBOL="$"
CURRENCY_POSITION=before

# ============================================
# RATE LIMITING
# ============================================

# API Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Login Rate Limiting
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_DECAY=60

# ============================================
# CORS CONFIGURATION
# ============================================

CORS_ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"
CORS_ALLOWED_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_ALLOWED_HEADERS="Content-Type,Authorization,X-Requested-With"
CORS_ALLOW_CREDENTIALS=true

# ============================================
# MAINTENANCE MODE
# ============================================

MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System is under maintenance. Please try again later."
MAINTENANCE_ALLOWED_IPS="127.0.0.1,::1"
